{
  "name": "smarthr-ai",
  "version": "1.0.0",
  "description": "SmartHR AI - Intelligent Human Resource Management System",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build:all": "npm run build:backend && npm run build:frontend",
    "start:backend": "npm start --prefix backend",
    "start:frontend": "npm run preview --prefix frontend",
    "prisma:generate": "npm run prisma:generate --prefix backend",
    "prisma:migrate": "npm run prisma:migrate --prefix backend",
    "prisma:seed": "npm run prisma:seed --prefix backend",
    "prisma:studio": "npm run prisma:studio --prefix backend"
  },
  "keywords": [
    "hr",
    "management",
    "ai",
    "smarthr",
    "payroll",
    "attendance",
    "recruitment"
  ],
  "author": "",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ]
}
